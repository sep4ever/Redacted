  Options:
  - optionEffect:
      eventType: 3
      value: 0
    OptionDescription: "\u041E\u0434\u043D\u0430\u043A\u043E, \u043D\u0430\u0448\u0430
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u0430,
      \u0447\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043F\u0443\u0442\u044C \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435 \u0441 [\u0414\u0410\u041D\u041D\u042B\u0415
      \u0423\u0414\u0410\u041B\u0415\u041D\u042B], \u0433\u0434\u0435 \u0434\u0430\u0432\u0435\u0447\u0430
      \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B\u0430 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0441\u043A\u0430\u044F
      \u0432\u043E\u0439\u043D\u0430. \u041A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435
      \u043F\u0443\u0442\u0438 \u0438 \u0438\u043C\u0435\u043D\u0430 \u0432\u044B\u044F\u0441\u043D\u044F\u044E\u0442\u0441\u044F."
    NextMessage: {fileID: 11400000, guid: 7031d14b9c4b14af9bf0acbe4f2a25e4, type: 2}
    dayCount: 2
    triggerDayChange: 1
  - optionEffect:
      eventType: 2
      value: -1
    OptionDescription: "\u0414\u0430\u043D\u043D\u044B\u0435, \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0435
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u044B\u0441\u043A\u0430,
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u044E\u0442. \u041F\u043E\u043C\u0438\u043C\u043E
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0439, \u0431\u044B\u043B\u0438
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0435\u0439\u0444\u044B
      \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u043C, \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438
      \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F\u043C\u0438, \u0438\u043C\u043F\u043E\u0440\u0442\u043D\u043E\u0439
      \u0442\u0435\u0445\u043D\u0438\u043A\u0438 \u0438 \u0434\u0430\u0436\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0440\u0443\u0431\u0435\u0436\u043D\u044B\u0445
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0435\u0439."
    NextMessage: {fileID: 11400000, guid: 7031d14b9c4b14af9bf0acbe4f2a25e4, type: 2}
    dayCount: 2
    triggerDayChange: 1
  Text: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u043E\u0447\u044C\u044E,
    \"\u041D\u0435 \u043E\u0442\u0445\u043E\u0434\u044F \u043E\u0442 \u043A\u0430\u0441\u0441\u044B\",
    \u0431\u044B\u043B\u0438 \u043E\u0442\u043B\u043E\u0432\u043B\u0435\u043D\u044B
    4 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u0447\u043B\u0435\u043D\u043E\u0432 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
    \u043C\u0430\u0444\u0438\u0438! \u0412 \u0445\u043E\u0434\u0435 \u0434\u043E\u043F\u0440\u043E\u0441\u0430
    \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0433\u0434\u0435
    \u0431\u0435\u0440\u0435\u0442 \u043D\u0430\u0447\u0430\u043B\u043E \u043D\u0430\u0440\u043A\u043E\u0442\u0440\u0430\u0444\u0438\u043A
    \u043F\u043E \u0432\u0441\u0435\u0439 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u0440\u0430\u043D\u044B. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0432\u0441\u044E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0443\u044E
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E, \u043F\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u043E\u0440\u0433\u0430\u043D\u0430\u043C \u0442\u0430\u043A \u0438 \u043D\u0435
    \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0441\u043B\u0435\u0434\u0438\u0442\u044C
    \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0447\u0438\u043D\u043E\u0432
    \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u0438, \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F."
