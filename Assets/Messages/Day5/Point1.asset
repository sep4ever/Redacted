  Options:
  - optionEffect:
      eventType: 1
      value: 1
    OptionDescription: "\u041B\u0438\u0434\u0435\u0440\u044B \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u043E\u0433\u043E
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430 \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438
      \u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E
      \u0442\u0440\u0438\u0431\u0443\u043D\u0430\u043B\u0430, \u043E\u0431\u0432\u0438\u043D\u044F\u044F
      \u0441\u0438\u043B\u043E\u0432\u0438\u043A\u043E\u0432 \u0432 \u043C\u0430\u0441\u0441\u043E\u0432\u044B\u0445
      \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430\u0445, \u0443\u0437\u0443\u0440\u043F\u0430\u0446\u0438\u0438
      \u0432\u043B\u0430\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0438
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0431\u044E\u0434\u0436\u0435\u0442\u0430."
    NextMessage: {fileID: 11400000, guid: bb5528f39884989b392b26042d3b2990, type: 2}
    dayCount: 6
