  - optionEffect:
      eventType: 0
      value: 1
    OptionDescription: "\u0412 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u043C \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u043E\u043C
      \u0434\u043E\u043A\u043B\u0430\u0434\u0435 \u0441\u0438\u043B\u043E\u0432\u043E\u0433\u043E
      \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u0430 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0438
      \u043F\u0440\u043E\u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C\u0438 \u0441\u043F\u0435\u0446\u0441\u043B\u0443\u0436\u0431\u0430\u043C\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043D\u044B\u0435
      \u043A\u0440\u0438\u043F\u0442\u043E\u0432\u0430\u043B\u044E\u0442\u043D\u044B\u0435
      \u0444\u043E\u043D\u0434\u044B."
    NextMessage: {fileID: 11400000, guid: bb5528f39884989b392b26042d3b2990, type: 2}
    dayCount: 6
    triggerDayChange: 1
  Text: "\u0422\u044B\u0441\u044F\u0447\u0438 \u0440\u0430\u0437\u044A\u044F\u0440\u0435\u043D\u043D\u044B\u0445
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D, \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445
    \u0430\u0440\u043C\u0430\u0442\u0443\u0440\u043E\u0439, \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044F\u043C\u0438
    \u041C\u043E\u043B\u043E\u0442\u043E\u0432\u0430 \u0438 \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u043C\u0438
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u043C\u0438, \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0438
    \u043E\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0433\u0432\u0430\u0440\u0434\u0438\u0438 \u0438 \u0432\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C
    \u043D\u0430 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u043F\u043B\u043E\u0449\u0430\u0434\u044C
    \u043C\u0438\u043D\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430. \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u043E\u0436\u0435\u0441\u0442\u043E\u0447\u0435\u043D\u043D\u044B\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
    \u0441 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C \u043E\u0433\u043D\u0435\u0441\u0442\u0440\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F \u0438 \u0441\u043B\u0435\u0437\u043E\u0442\u043E\u0447\u0438\u0432\u043E\u0433\u043E
    \u0433\u0430\u0437\u0430."
