  Options:
  - optionEffect:
      eventType: 3
      value: 0
    OptionDescription: "\u041A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u043E\u043A\u0440\u0443\u0433\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u043E,
      \u0447\u0442\u043E \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0435
      \u0431\u044B\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u044D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      [\u0414\u0410\u041D\u041D\u042B\u0415 \u0423\u0414\u0410\u041B\u0415\u041D\u042B]
      \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u043F\u043E \u043F\u0440\u0438\u043A\u0430\u0437\u0443 \u0441\u043F\u0435\u0446\u0441\u043B\u0443\u0436\u0431
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u043E\u0433\u043E
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430."
    NextMessage: {fileID: 11400000, guid: e3c7afa07e1ca4ca39bb9b8985600415, type: 2}
    dayCount: 4
    triggerDayChange: 1
  - optionEffect:
      eventType: 0
      value: 1
    OptionDescription: "\u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0432 \u0448\u0442\u0430\u0431\u0435
      \u0441\u043E\u043E\u0431\u0449\u0430\u0435\u0442, \u0447\u0442\u043E \u043F\u0440\u043E\u0440\u044B\u0432
      \u0441\u0442\u0430\u043B \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C
      \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u043D\u043E\u0439 \u0445\u0430\u043B\u0430\u0442\u043D\u043E\u0441\u0442\u0438
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0445
      \u0432\u043E\u0439\u0441\u043A, \u043F\u0440\u043E\u0434\u0430\u0432\u0448\u0435\u0433\u043E
      \u0441\u043A\u043B\u0430\u0434\u044B \u0441 \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438
      \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u0430\u043C."
    NextMessage: {fileID: 11400000, guid: e3c7afa07e1ca4ca39bb9b8985600415, type: 2}
    dayCount: 4
    triggerDayChange: 1
  Text: "\u041F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0435 \u0432\u043E\u0439\u0441\u043A\u0430
    \u0432\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u0432 \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0439
    \u0431\u043E\u0439 \u0441 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
    \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u0438\u0440\u043E\u0432\u043A\u043E\u0439,
    \u043F\u044B\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u044C
    \u0437\u0430\u0441\u0442\u0430\u0432\u044B \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u043C
    \u0440\u0443\u0431\u0435\u0436\u0435. \u0412 \u0445\u043E\u0434 \u043F\u043E\u0448\u043B\u0438
    \u0442\u044F\u0436\u0435\u043B\u044B\u0435 \u043F\u0443\u043B\u0435\u043C\u0435\u0442\u044B,
    \u043C\u0438\u043D\u043E\u043C\u0435\u0442\u044B \u0438 \u0431\u0440\u043E\u043D\u0435\u0442\u0435\u0445\u043D\u0438\u043A\u0430,
    \u0430 \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u044F \u0432\u0435\u043B\u0430
    \u043E\u0433\u043E\u043D\u044C \u043D\u0430 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0447\u0430\u0441\u043E\u0432."
