  Options:
  - optionEffect:
      eventType: 1
      value: 1
    OptionDescription: "\u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445
      \u0448\u043A\u043E\u043B\u044C\u043D\u0438\u043A\u043E\u0432 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438
      \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0439 \u043C\u0438\u0442\u0438\u043D\u0433
      \u0443 \u0437\u0434\u0430\u043D\u0438\u044F \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438,
      \u0442\u0440\u0435\u0431\u0443\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0439
      \u043E\u0442\u0441\u0442\u0430\u0432\u043A\u0438 \u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430
      \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u0441\u0438\u043B\u043E\u0432\u0438\u043A\u043E\u0432."
    NextMessage: {fileID: 11400000, guid: 8722f4fc7a5c7cd739ead271a9c1c8ee, type: 2}
    dayCount: 5
    triggerDayChange: 1
  - optionEffect:
      eventType: 2
      value: -1
    OptionDescription: "\u041F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0439 \u0440\u0430\u0437\u0431\u043E\u0440
      \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438 \u0438 \u0438\u043D\u0442\u0435\u0440\u0432\u044C\u044E
      \u0441 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0430\u043C\u0438 \u0431\u044B\u043B\u0438
      \u0438\u0437\u044A\u044F\u0442\u044B \u0446\u0435\u043D\u0437\u043E\u0440\u0430\u043C\u0438
      \u0438\u0437 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u0438\u0440\u0430\u0436\u0430
      \u0433\u0430\u0437\u0435\u0442\u044B \u043F\u043E \u0441\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u043C
      \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    NextMessage: {fileID: 11400000, guid: 8722f4fc7a5c7cd739ead271a9c1c8ee, type: 2}
    dayCount: 5
    triggerDayChange: 1
  Text: "\u0421\u043F\u0435\u0446\u043D\u0430\u0437 \u043F\u043E\u0448\u0435\u043B
    \u043D\u0430 \u0448\u0442\u0443\u0440\u043C \u0437\u0434\u0430\u043D\u0438\u044F
    \u0441\u043F\u0443\u0441\u0442\u044F \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
    \u043F\u043E\u0441\u043B\u0435 \u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0430\u0434\u044B.
    \u041D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0439 \u0431\u044B\u043B
    \u043B\u0438\u043A\u0432\u0438\u0434\u0438\u0440\u043E\u0432\u0430\u043D \u0441\u043D\u0430\u0439\u043F\u0435\u0440\u043E\u043C,
    \u043E\u0434\u043D\u0430\u043A\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
    \u0436\u0435\u0440\u0442\u0432 \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u043B\u043E\u0436\u043D\u0438\u043A\u043E\u0432,
    \u0443\u0432\u044B, \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C -
    \u043F\u043E\u0433\u0438\u0431\u043B\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0434\u0435\u0442\u0435\u0439."
