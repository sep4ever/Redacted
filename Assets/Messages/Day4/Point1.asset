  Options:
  - optionEffect:
      eventType: 3
      value: 0
    OptionDescription: "\u0412 \u043E\u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u043C
      \u043C\u0430\u043D\u0438\u0444\u0435\u0441\u0442\u0435 \u0441\u0442\u0440\u0435\u043B\u043E\u043A
      \u0437\u0430\u044F\u0432\u0438\u043B, \u0447\u0442\u043E \u0438\u0434\u0435\u0442
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0448\u0430\u0433 \u0438\u0437-\u0437\u0430
      \u0442\u043E\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043D\u0438\u0449\u0435\u0442\u044B
      \u0441\u0435\u043C\u0435\u0439 \u0438 \u043A\u043E\u0440\u0440\u0443\u043F\u0446\u0438\u0438
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432, \u0443\u043A\u0440\u0430\u0432\u0448\u0438\u0445
      \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0443 \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438."
    NextMessage: {fileID: 11400000, guid: 8722f4fc7a5c7cd739ead271a9c1c8ee, type: 2}
