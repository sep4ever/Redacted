  - optionEffect:
      eventType: 0
      value: 1
    OptionDescription: "\u041F\u043E \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0434\u0430\u043D\u043D\u044B\u043C \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F,
      \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043E\u043A \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0441\u044F
      \u043F\u043E\u0434 \u0432\u043B\u0438\u044F\u043D\u0438\u0435\u043C \u0434\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u044B\u0445
      \u0440\u0430\u0434\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u0435\u043A\u0442,
      \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u0443\u0435\u043C\u044B\u0445
      \u0438\u0437-\u0437\u0430 \u0440\u0443\u0431\u0435\u0436\u0430 \u0441 \u0446\u0435\u043B\u044C\u044E
      \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u0438\u044F \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439."
    NextMessage: {fileID: 11400000, guid: 8722f4fc7a5c7cd739ead271a9c1c8ee, type: 2}
