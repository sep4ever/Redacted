  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041C\u0418\u041D\u0418\u0421\u0422\u0415\u0420\u0421\u0422\u0412\u041E
    \u0418\u041D\u0424\u041E\u0420\u041C\u0410\u0426\u0418\u0418 \u0418 \u041F\u0415\u0427\u0410\u0422\u0418\n\u0426\u0415\u041D\u0422\u0420\u0410\u041B\u042C\u041D\u042B\u0419
    \u0418\u0417\u0414\u0410\u0422\u0415\u041B\u042C\u0421\u041A\u0418\u0419 \u041A\u041E\u041C\u0418\u0422\u0415\u0422\n\u041E\u0422\u0414\u0415\u041B
    \u041E\u041F\u0415\u0420\u0410\u0422\u0418\u0412\u041D\u041E\u0413\u041E \u041A\u041E\u041D\u0422\u0420\u041E\u041B\u042F\n\n\u0414\u041E\u0421\u042C\u0415
    \u0421\u041E\u0422\u0420\u0423\u0414\u041D\u0418\u041A\u0410 \u2116 404-\u0420\n\u0414\u041E\u041B\u0416\u041D\u041E\u0421\u0422\u042C:
    \u0420\u0435\u0434\u0430\u043A\u0442\u043E\u0440 \u043F\u0435\u0447\u0430\u0442\u043D\u043E\u0433\u043E
    \u043E\u0440\u0433\u0430\u043D\u0430\n\n\u041D\u0410\u0421\u0422\u041E\u042F\u0429\u0418\u041C
    \u0423\u0414\u041E\u0421\u0422\u041E\u0412\u0415\u0420\u042F\u0415\u0422\u0421\u042F,
    \u0447\u0442\u043E \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0439 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\u0438\u043D
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043D\u0430 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C
    \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440\u0430 \u0441\u0443\u0442\u043E\u0447\u043D\u043E\u0433\u043E
    \u0432\u044B\u043F\u0443\u0441\u043A\u0430 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439
    \u0441\u0440\u043E\u043A\u043E\u043C \u043D\u0430 2000 \u0440\u0430\u0431\u043E\u0447\u0438\u0445
    \u0446\u0438\u043A\u043B\u043E\u0432. \n\n\u041E\u0417\u041D\u0410\u041A\u041E\u041C\u042C\u0422\u0415\u0421\u042C
    \u0421 \u0412\u0410\u0428\u0418\u041C\u0418 \u041F\u041E\u041B\u041D\u041E\u041C\u041E\u0427\u0418\u042F\u041C\u0418:\n1.
    \u041A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E \u0432 \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0435
    \u0438 \u0442\u0435\u043A\u0441\u0442\u0435 \u0441\u0442\u0430\u0442\u044C\u0438
    \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442 \u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0443\u044E
    \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438
    \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u0438. \n2. \u041B\u044E\u0431\u0430\u044F
    \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u044F
    \u0442\u043E\u0433\u043E \u0438\u043B\u0438 \u0438\u043D\u043E\u0433\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F
